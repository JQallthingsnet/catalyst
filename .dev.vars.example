# Copy to .dev.vars for local development. Never commit .dev.vars.

# Required for session cookies.
AUTH_SECRET=replace-with-a-long-random-string

# Show the 8-digit code on the login page when SMTP is not set.
AUTH_DEV_RETURN_CODE=true

# Preferred: Resend (same secret name as production). When set, codes and portal mail go via Resend.
# resend_api_key=re_xxxxxxxx
# Optional From override (default is ATN Catalyst <notifications@notify.allthingsnet.io>):
# RESEND_FROM=ATN Catalyst <notifications@notify.allthingsnet.io>

# Legacy fallback JSON secret (same name as the Worker setting).
# gmail-smtp-keys={"gmail-smtp-email":"you@gmail.com","gmail-smtp-password":"app-password","gmail-smtp-host":"smtp.gmail.com","gmail-smtp-port":"465"}

# Your email becomes a super admin on first portal load. Comma-separated for more than one.
# SUPER_ADMIN_EMAIL=you@company.com

# Control Center (Jasper). Worker secrets in production — never commit real values.
# HTTP Basic: Base64(JASPER_ACCOUNT_NAME:JASPER_API_KEY) — colon, no space.
# JASPER_ACCOUNT_NAME=your-cc-username
# JASPER_API_KEY=your-cc-api-key
# Required for many production accounts (device search returns AccountId is required without it):
# JASPER_ACCOUNT_ID=your-cc-account-id
# Leave unset in production (auto poll is on). Local quiet while wiring APIs:
# CC_AUTO_POLL=false
