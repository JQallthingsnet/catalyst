# Copy to .dev.vars for local development. Never commit .dev.vars.

# Required for session cookies.
AUTH_SECRET=replace-with-a-long-random-string

# Show the 8-digit code on the login page when SMTP is not set.
AUTH_DEV_RETURN_CODE=true

# Optional JSON secret. When set, login codes are emailed via Microsoft 365 (GoDaddy).
# smtp-keys={"smtp-email":"you@yourdomain.com","smtp-password":"your-password","smtp-host":"smtp.office365.com","smtp-port":"587"}
