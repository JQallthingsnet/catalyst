{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catalyst",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "triggers": {
    // Separate schedules (same Worker, branched in worker.ts via controller.cron):
    // 1) CC poll — hourly. Optus rate-limits when we tick too often; Free also caps
    //    ~50 subrequests/tick. Hourly keeps account cool and still moves the queue.
    // 2) ≥80% usage digest email — near Sydney midnight (13:00 UTC = AEDT midnight, 14:00 = AEST)
    "crons": ["0 * * * *", "0 13 * * *", "0 14 * * *"]
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalyst-db",
      "database_id": "1cdbc21b-2359-4457-bab4-c2a7001225fa",
      "migrations_dir": "migrations"
    }
  ]
}
