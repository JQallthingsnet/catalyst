{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catalyst",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "triggers": {
    // Separate schedules (same Worker, branched in worker.ts via controller.cron):
    // 1) CC poll — every 5 min. Free Workers = 50 subrequests/invocation; we use many
    //    tiny ticks (soft Jasper cap in devices.ts) instead of one long tick that hits
    //    "Too many subrequests". */5 is <1h so Paid CPU is 30s — OK for short ticks.
    // 2) ≥80% usage digest email — near Sydney midnight (13:00 UTC = AEDT midnight, 14:00 = AEST)
    "crons": ["*/5 * * * *", "0 13 * * *", "0 14 * * *"]
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalyst-db",
      "database_id": "1cdbc21b-2359-4457-bab4-c2a7001225fa",
      "migrations_dir": "migrations"
    }
  ]
}
