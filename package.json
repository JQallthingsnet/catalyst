{
  "name": "catalyst",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
